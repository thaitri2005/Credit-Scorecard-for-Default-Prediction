classes: {
  box: {
    style: {fill: "#ffffff"; stroke: "#10293f"; stroke-width: 1; border-radius: 6; font-color: "#14212e"; font-size: 15}
  }
  group: {
    style: {fill: "#f1f3f5"; stroke: "#c3ccd5"; stroke-width: 1; border-radius: 8; font-color: "#10293f"; font-size: 17; bold: true}
  }
  actor: {
    style: {fill: "#e4eef8"; stroke: "#0b5aa8"; stroke-width: 1; border-radius: 6; font-color: "#14212e"; font-size: 15}
  }
  store: {
    shape: cylinder
    style: {fill: "#ffffff"; stroke: "#10293f"; stroke-width: 1; font-color: "#14212e"; font-size: 15}
  }
  key: {
    style: {fill: "#10293f"; stroke: "#10293f"; border-radius: 6; font-color: "#ffffff"; font-size: 15; bold: true}
  }
  good: {
    style: {fill: "#e3f1ea"; stroke: "#1b7a52"; stroke-width: 1; border-radius: 6; font-color: "#14212e"; font-size: 15}
  }
  note: {
    shape: text
    style: {font-color: "#556270"; font-size: 14}
  }
}
